---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';
---

<Base title="Projects" description="Project kecil dan eksperimen buatan Daffa.">
  <p class="eyebrow">$ ls projects/</p>
  <h1 class="page-title">Projects</h1>
  <p class="lede">Eksperimen dan project kecil yang pernah gue bikin.</p>
  <div class="cards">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>
