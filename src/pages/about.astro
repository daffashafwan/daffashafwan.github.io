---
import Base from '../layouts/Base.astro';
import { experience, site, skills, summary } from '../data/site';
---

<Base title="About" description="Daffa Shafwan, backend software engineer.">
  <p class="eyebrow">$ cat about.md</p>
  <h1 class="page-title">Hi, I am Daffa.</h1>
  <p class="lede">{summary}</p>

  <section class="section" style="margin-top:0">
    <div class="section-head"><h2>skills</h2></div>
    <dl class="skills">
      {skills.map((g) => (
        <>
          <dt>{g.label}</dt>
          <dd class="tags">{g.items.map((i) => <span class="tag">{i}</span>)}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="section">
    <div class="section-head"><h2>experience</h2></div>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <h3>{e.company}</h3>
          {e.roles.map((r) => (
            <>
              <div class="role">
                <span>{r.title}</span>
                <span>{r.period}</span>
              </div>
              <ul class="plain-list points">{r.points.map((pt) => <li>{pt}</li>)}</ul>
            </>
          ))}
        </li>
      ))}
    </ol>
  </section>

  <section class="section">
    <div class="section-head"><h2>education</h2></div>
    <p style="margin:0">Bachelor of Informatics (Data Science), Universitas Muhammadiyah Malang · GPA 3.93</p>
  </section>

  <section class="section">
    <div class="section-head"><h2>contact</h2></div>
    <p style="margin:0">
      Email me at <a href={`mailto:${site.email}`}>{site.email}</a>, or find me on
      {site.social.map((s, i) => (<><a href={s.url} rel="me noopener">{s.name}</a>{i < site.social.length - 1 ? ', ' : '.'}</>))}
    </p>
  </section>
</Base>
