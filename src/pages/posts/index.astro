---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="Writing" description="Tulisan dan catatan harian Daffa.">
  <p class="eyebrow">$ ls posts/</p>
  <h1 class="page-title">Writing</h1>
  <p class="lede">Catatan soal engineering, resolusi, dan keseharian.</p>
  <div class="tags" style="margin-bottom:1.5rem">
    {tags.map(([t, n]) => <a class="tag" href={`/tags/${t}/`}>#{t} · {n}</a>)}
  </div>
  <PostList posts={posts} />
</Base>
