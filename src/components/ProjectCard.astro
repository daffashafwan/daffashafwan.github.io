---
import { Image } from 'astro:assets';
import type { projects } from '../data/site';
interface Props { project: (typeof projects)[number] }
const { project } = Astro.props;
---

<a class="card" href={project.url}>
  <Image src={project.image} alt={`Tampilan ${project.title}`} width={640} loading="lazy" />
  <div class="body">
    <span class="year">{project.year}</span>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="tags">
      {project.stack.map((s) => <span class="tag">{s}</span>)}
    </div>
  </div>
</a>
